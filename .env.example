# Copy to .env.local and fill in. .env* is git-ignored — never commit a key.
# Every variable here is OPTIONAL: the board plans, explains and replans with
# none of them set.

# --- Map ---------------------------------------------------------------
# Clears the watermark CARTO puts on its free tiles. https://carto.com/basemaps/apikey
# Inlined into the client bundle, as any browser map key must be. Restrict it by
# domain in the CARTO dashboard rather than treating it as a secret.
NEXT_PUBLIC_CARTO_KEY=

# --- Supabase ----------------------------------------------------------
# Enables "publish this day" so a case you write can be opened by anyone with
# the live URL. Without these, your days are kept in your own browser instead.
# The publishable key is designed to be public; row-level security is what
# protects the data. See supabase/migrations/0001_shared_days.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Gemini ------------------------------------------------------------
# Enables the assistant in the console. Without it the console still answers,
# using its own grammar.
#
# NOTE THE MISSING NEXT_PUBLIC_ PREFIX. This key is read only by the server
# route in app/api/chat/route.ts and must never be exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
